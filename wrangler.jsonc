{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shirogane-production-suite",
  "main": "./cloudflare-worker.js",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/.well-known/assetlinks.json"]
  }
}
